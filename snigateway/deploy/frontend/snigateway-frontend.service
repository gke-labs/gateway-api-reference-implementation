[Unit]
Description=SNIGateway Frontend Proxy
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snigateway
Group=snigateway
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/local/bin/snigateway-frontend \
  --listen :443 \
  --client-ca /etc/snigateway/ca.crt=* \
  --server-cert /etc/snigateway/server.crt \
  --server-key /etc/snigateway/server.key
Restart=always
RestartSec=5s
LimitNOFILE=65535

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/snigateway
PrivateTmp=true

[Install]
WantedBy=multi-user.target
